        { "kind": "inspect", "command": "READ LOG", "label": "Read log", "itemId": "log" },
        {
          "kind": "end",
          "command": "FILE LOG",
          "label": "File log",
          "when": "read:log",
          "endingId": "filed"
        },
        { "kind": "move", "command": "UP", "label": "Go up", "toLocationId": "landing" }
      ]
    }
  ],
  "items": [{ "id": "log", "text": ["Bench log: switch tested."] }],
  "flags": [],
  "endings": [{ "id": "filed", "text": ["The bench log is filed."] }],
  "orderPuzzles": [],
  "rewardRules": [{ "reward": "flag:bench-log-filed", "when": "completed:filed" }]
