{
  "kind": "adventure",
  "id": "tiny-adventure",
  "name": "BENCH LOG",
  "description": "A fixture adventure with one piece of evidence.",
  "attribution": { "author": "Test" },
  "version": 1,
  "requires": "completed:episode.000",
